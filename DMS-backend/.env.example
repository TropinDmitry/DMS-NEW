# Скопируй в .env и поменяй значения. Файл .env в git не попадает.
PORT=8080
NODE_ENV=development

# Секрет для подписи JWT. В продакшене ОБЯЗАТЕЛЬНО длинная случайная строка:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Куда писать базу и загруженные файлы (по умолчанию ./data и ./uploads)
# DB_PATH=./data/dms.db
# UPLOADS_DIR=./uploads

# Первый администратор для продакшена (в dev создаётся admin@dms.local / admin123 вместе с демо-данными)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=strong-password
